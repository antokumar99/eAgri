# Copy this file to Backend/.env and fill in the values.
#   cp Backend/.env.example Backend/.env
#
# Backend/.env is gitignored — never commit it.
#
# Only two settings are REQUIRED to boot: MONGO_URI and JWT_SECRET.
# The server refuses to start without them. Everything else disables a single
# feature when missing, rather than breaking the app.


# ============================ REQUIRED ============================

# ---- Database ----
# MongoDB Atlas (free tier is fine): https://cloud.mongodb.com
#   Create cluster -> Connect -> Drivers -> copy the connection string.
#   Replace <password> with your database user's password, and put a database
#   name after the last "/" (here: eagri).
#   If the password contains @ : / ? # or %, URL-encode it (@ becomes %40).
#   Under Network Access, allow your IP (or 0.0.0.0/0 for local development).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eagri

# ---- Auth ----
# Signs login tokens. Any long random string; never share it. Changing it logs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret


# ======================= FEATURES (optional) =======================

# ---- Image uploads ---- (posts and product photos)
# https://console.cloudinary.com -> Dashboard shows all three.
# Without these, uploads fail with a clear message; the rest of the app works.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Email verification ----
# Gmail App Password — NOT your normal password. Requires 2-Step Verification:
#   https://myaccount.google.com/apppasswords
# Google displays it as "abcd efgh ijkl mnop"; paste it either way, spaces are
# stripped. If sending fails, signup still succeeds and the verification link
# is written to the server log.
EMAIL_USERNAME=you@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# Set true to create accounts already verified, so you can log in without any
# working email. Development only — ignored when NODE_ENV=production.
AUTO_VERIFY_USERS=false

# ---- Online payment ----
# Free sandbox account: https://developer.sslcommerz.com/registration/
# Without these, card payment returns a clear 503 and Cash on Delivery still
# works. Keep IS_LIVE=false until you have live merchant credentials.
STORE_ID=your_store_id
STORE_PASSWD=your_store_password
IS_LIVE=false


# ========================== ADVANCED ==============================
# Everything below has a sensible default. Leave it alone unless you need it.

# Port to listen on.
# PORT=3000

# "production" hides internal error details and disables AUTO_VERIFY_USERS.
# NODE_ENV=development

# Public base URL of this API, used for SSLCommerz callbacks and the links in
# verification emails. Leave unset in development: the server detects this
# machine's LAN address automatically, so it keeps working when your router
# hands out a new IP.
# Set it explicitly when the API is deployed, or when tunnelling (ngrok) so
# SSLCommerz's servers can deliver IPN callbacks.
# BACKEND_URL=https://your-api.example.com
# FRONTEND_URL=https://your-api.example.com

# Comma-separated browser origins allowed by CORS. Unset means allow all, which
# is fine for the mobile app (it sends a bearer token, not cookies).
# ALLOWED_ORIGINS=https://your-web-app.example.com

# Order charges, in BDT.
# DELIVERY_FEE=50
# COD_FEE=30
