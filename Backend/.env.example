# Copy this file to Backend/.env and fill in real values.
# Backend/.env is gitignored — never commit it.

# ---- Server ----
PORT=3000
NODE_ENV=development

# Public base URL of this API. SSLCommerz calls back to it from its own servers,
# so it must be reachable from outside this machine. In development, use the LAN
# IP of the host running the backend (the same one eAgri/config/apiConfig.js
# points at). For a real sandbox/live integration this must be a public URL.
BACKEND_URL=http://192.168.0.103:3000

# Used in verification emails.
FRONTEND_URL=http://192.168.0.103:3000
MOBILE_APP_URL=eagri://

# ---- Database ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eagri

# ---- Auth ----
# Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace_with_a_long_random_secret

# ---- Email (Gmail app password, not your account password) ----
EMAIL_USERNAME=you@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# ---- SSLCommerz ----
# Sandbox credentials: https://developer.sslcommerz.com/registration/
STORE_ID=your_store_id
STORE_PASSWD=your_store_password
IS_LIVE=false

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Pricing (optional, defaults shown) ----
DELIVERY_FEE=50
COD_FEE=30
